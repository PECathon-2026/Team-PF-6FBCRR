{
  "scenarios": {
    "checkout": {
      "name": "E-Commerce Checkout Flow",
      "target_file": "checkout.html",
      "task": "Add item to cart and proceed to payment review without completing final purchase",
      "expected_outcome": "REACHED_CONFIRMATION",
      "ground_truth_pii": [
        {"category": "NAME", "description": "Full name recipient input"},
        {"category": "ADDRESS", "description": "Shipping address input"},
        {"category": "CREDIT_CARD", "description": "Card number input field"},
        {"category": "CVV", "description": "CVV security code input field"}
      ]
    },
    "auth": {
      "name": "Enterprise Two-Factor Authentication",
      "target_file": "auth.html",
