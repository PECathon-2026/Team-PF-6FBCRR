# PrivacyLens Backend Environment Configuration Template
# Copy to .env and configure as needed. NEVER commit .env to source control!

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,chrome-extension://*

# AI Provider Settings ("deterministic-mock", "gemini", or "openai")
AI_PROVIDER=deterministic-mock

# Optional Cloud AI API Keys (leave empty to use deterministic mock)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Privacy & Security Policy
STRICT_CANARY_ENFORCEMENT=true
FAIL_CLOSED_ON_DETECTION_ERROR=true
MAX_PAYLOAD_SIZE_BYTES=1048576
APPROVAL_TIMEOUT_SECONDS=300
